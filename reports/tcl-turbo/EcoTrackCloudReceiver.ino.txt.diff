+// Advertise controls implemented by the detected decoder/encoder, independently of the UI brand.
+void addReceiverAcCapabilities(JsonDocument &frame, const stdAc::state_t &state) {
+  if (state.protocol != TCL112AC) return;
+  JsonObject caps = frame["ac_capabilities"].to<JsonObject>();
+  caps["power"] = true; caps["temperature"] = true;
+  caps["min_temp"] = kTcl112AcTempMin; caps["max_temp"] = kTcl112AcTempMax;
+  JsonArray modes = caps["modes"].to<JsonArray>();
+  for (const char *mode : {"cool","dry","fan","auto","heat"}) modes.add(mode);
+  JsonArray fans = caps["fans"].to<JsonArray>();
+  for (const char *fan : {"low","medium","high","auto","quiet"}) fans.add(fan);
+  caps["swing"] = true; caps["turbo"] = true; caps["eco"] = true;
+  caps["sleep"] = false; caps["timer"] = false; // Not sent by IRac::tcl112.

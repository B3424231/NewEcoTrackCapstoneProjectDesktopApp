# EcoTrack Environment Configuration
# Local SQLite telemetry API
BACKEND_URL=http://localhost:5000
# Optional Python database override: ECOTRACK_SQLITE_DB_PATH

# Supabase (Cloud Database for Auth, Buildings, Floors, Rooms, Nodes, Rules, Notifications)
# Replace with your project URL (e.g., https://xyzcompany.supabase.co)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your_supabase_anon_key
SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key
